// Generated into the build folder by Installer/Windows/CMakeLists.txt (file(GENERATE)).
#include "@CLIPLINE_INSTALLER_DIR@/resource.h"

1 24 "@CLIPLINE_INSTALLER_DIR@/installer.manifest"
IDI_APP ICON "@CLIPLINE_INSTALLER_DIR@/clipline.ico"

IDR_PLUGIN_BINARY RCDATA "@CLIPLINE_PAYLOAD_PLUGIN@"
IDR_README        RCDATA "@CLIPLINE_INSTALLER_DIR@/README.txt"
IDR_LICENSE_OFL   RCDATA "@CLIPLINE_SOURCE_DIR@/Resources/Fonts/OFL-Geist.txt"

1 VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "@CLIPLINE_COMPANY_NAME@"
      VALUE "FileDescription",  "@CLIPLINE_PRODUCT_NAME@ VST3 Setup"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "ProductName",      "@CLIPLINE_PRODUCT_NAME@"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "@CLIPLINE_INSTALLER_NAME@.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
