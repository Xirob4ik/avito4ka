<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Clipline @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <os-version min="10.13"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="/Library/Audio/Plug-Ins/VST3 — FL Studio, Ableton Live, REAPER, Cubase, Studio One">
        <pkg-ref id="com.cliplineaudio.clipline.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)" description="/Library/Audio/Plug-Ins/Components — Logic Pro, GarageBand, FL Studio, Ableton Live">
        <pkg-ref id="com.cliplineaudio.clipline.au"/>
    </choice>
    <pkg-ref id="com.cliplineaudio.clipline.vst3">Clipline-vst3.pkg</pkg-ref>
    <pkg-ref id="com.cliplineaudio.clipline.au">Clipline-au.pkg</pkg-ref>
</installer-gui-script>
